{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "echo 'Static website with serverless functions'",
  "outputDirectory": ".",
  "redirects": [
    {
      "source": "/(.*)",
      "has": [
        {
          "type": "host",
          "value": "tiefgarage-kiel-website.vercel.app"
        }
      ],
      "destination": "https://www.tiefgarage-kiel.de/$1",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "has": [
        {
          "type": "host",
          "value": "tiefgarage-kiel-website.vercel.app"
        }
      ],
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex"
        }
      ]
    }
  ],
  "functions": {
    "api/anfrage.js": {
      "memory": 1024,
      "maxDuration": 10
    }
  }
}
